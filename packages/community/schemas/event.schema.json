{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-help.local/schemas/event.schema.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "organiser",
    "format",
    "start",
    "timeZone",
    "city",
    "demonstration",
    "confirmation",
    "entrance",
    "seating",
    "washrooms",
    "arrival",
    "support",
    "registrationUrl",
    "registrationPhone",
    "cost",
    "supportPersonAdmission",
    "verificationTier",
    "source",
    "licence",
    "sourceDate",
    "recordDate",
    "inAppRegistration"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fr"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 }
      }
    },
    "organiser": { "type": "string", "minLength": 1 },
    "format": { "enum": ["in_person", "virtual", "hybrid"] },
    "start": { "type": "string", "format": "date-time" },
    "timeZone": { "const": "America/Toronto" },
    "city": { "type": "string", "minLength": 1 },
    "demonstration": { "type": "boolean" },
    "confirmation": {
      "enum": ["confirmed_for_this_occurrence", "not_confirmed_venue_note_only", "unknown"]
    },
    "entrance": { "type": "string", "minLength": 1 },
    "seating": { "type": "string", "minLength": 1 },
    "washrooms": { "type": "string", "minLength": 1 },
    "arrival": { "type": "string", "minLength": 1 },
    "support": { "type": "string", "minLength": 1 },
    "platform": { "type": "string" },
    "captions": { "type": "string" },
    "registrationUrl": { "type": "string", "format": "uri" },
    "registrationPhone": { "type": "string", "minLength": 1 },
    "cost": { "type": "string", "minLength": 1 },
    "supportPersonAdmission": { "type": "string", "minLength": 1 },
    "verificationTier": {
      "enum": ["PROTOTYPE-UNVERIFIED", "SEEDED-OPEN-DATA", "COMMUNITY-REPORTED"]
    },
    "source": { "type": "string", "minLength": 1 },
    "licence": { "type": "string", "minLength": 1 },
    "sourceDate": { "type": "string", "format": "date" },
    "recordDate": { "type": "string", "format": "date" },
    "inAppRegistration": { "const": false },
    "cancelled": { "type": "boolean" }
  }
}
