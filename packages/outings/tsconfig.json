{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "test",
    "harness",
    "*.ts"
  ],
  "exclude": [
    "test/e2e"
  ]
}
